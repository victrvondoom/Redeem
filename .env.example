# Backend (apps/api). Never commit a real .env.
REDEEM_DATABASE_URL=sqlite:///./redeem.db   # Postgres: postgresql+psycopg://user:pass@host:5432/redeem (database must be UTF8)
REDEEM_MASTER_KEY=                          # base64url, >=32 bytes; encrypts documents at rest. Required in production (else a dev key file is created in the data dir)
REDEEM_COOKIE_SECURE=false                  # true behind HTTPS
REDEEM_ALLOW_FAULT_INJECTION=true           # fixture-only demo faults; false in production
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_WEBHOOK_SECRET=                       # webhook: /api/v1/webhooks/bolna?token=<secret>
REDEEM_ALLOW_OUTBOUND_CALLS=false
REDEEM_OUTBOUND_TEST_NUMBERS=               # comma-separated E.164 numbers you are authorised to call
# Frontend (apps/web)
REDEEM_API_URL=http://127.0.0.1:8000
